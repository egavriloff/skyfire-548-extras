# AuctionBot 1.0.1 for SkyFire. Copy to auctionbot.conf beside worldserver.conf.
# Both agents default to disabled. A dedicated account with a character is required.
# Bot money is generated, not deducted from character wallets. Mail uses core handling.
# Prices above UINT32_MAX copper are skipped/capped to match the core outbid API.
# Cross-faction auction: only Neutral settings are used.
# Auctioneer GUID 0 = discover an existing spawned NPC; otherwise creature.guid.
AuctionHouseBot.Auctioneer.Alliance = 0
AuctionHouseBot.Auctioneer.Horde = 0
AuctionHouseBot.Auctioneer.Neutral = 0

