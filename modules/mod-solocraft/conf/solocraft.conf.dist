###################################################################################################
# SoloCraft
# GPL-2.0-or-later; AlexKulya / Legends of Azeroth
#
# Copy to solocraft.conf beside worldserver.conf and edit that file.
# The module loads solocraft.conf.dist first, then solocraft.conf on startup/reload.
#
# SoloCraft scales the player for group content rather than scaling creatures.
# Instance weights are used to calculate how strongly the player should be scaled.
#
# Enable/announce/debuff/XP values: 0 or 1.
# Stats: flat bonus per weight (0..1000).
# Spell power: level * multiplier * weight (0..1000).
# Class weights: 0..100 percent, used in the late-entry penalty only.
# Max.Level.Diff: 0..90.
# Instance levels: 1..90.
# Weights: 0..1000; 0 disables that mode.
#
# H keys retain upstream semantics:
# heroic dungeons OR 25-player raids, including LFR.
#
# Invalid numeric values are logged and replaced with their defaults.
# XP.Enabled=0 blocks XP while scaled.
# XP.Balancing.Enabled=1 blocks XP for penalized entrants.
#
# Group size uses the whole roster.
# Existing members are not rebalanced: exit/re-enter as a group.
###################################################################################################


###################################################################################################
# General
###################################################################################################

Solocraft.Enable = 0
Solocraft.Announce = 1
SoloCraft.Debuff.Enable = 1

Solocraft.XP.Enabled = 1
Solocraft.XP.Balancing.Enabled = 1

Solocraft.Max.Level.Diff = 10


###################################################################################################
# Player scaling
###################################################################################################

SoloCraft.Spellpower.Mult = 2.5
SoloCraft.Stats.Mult = 100.0


###################################################################################################
# Default content weights
#
# Used when no more specific instance weight overrides the default.
###################################################################################################

Solocraft.Dungeon.Level = 90

Solocraft.Dungeon = 5.0
Solocraft.Heroic = 10.0
Solocraft.Raid25 = 25.0
Solocraft.Raid40 = 40.0

Solocraft.ArgentTournamentRaidH10 = 10.0
Solocraft.ArgentTournamentRaidH25 = 25.0


###################################################################################################
# Class weights
#
# Percentages used by late-entry balancing logic.
###################################################################################################

SoloCraft.Warrior = 100
SoloCraft.Paladin = 100
SoloCraft.Hunter = 100
SoloCraft.Rogue = 100
SoloCraft.Priest = 100
SoloCraft.Death.Knight = 100
SoloCraft.Shaman = 100
SoloCraft.Mage = 100
SoloCraft.Warlock = 100
