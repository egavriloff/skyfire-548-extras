{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "module-ai.schema.json",
  "title": "SkyFire 5.4.8 Module with AI Review",
  "type": "object",
  "allOf": [{"$ref": "module-base.schema.json"}],
  "properties": {
    "schema": {"const": "module-ai"},
    "ai_review": {"type": "object", "additionalProperties": false, "required": ["data"], "properties": {"data": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}}}
  },
  "required": ["ai_review"],
  "unevaluatedProperties": false
}
