{
  "$schema": "https://opencode.ai/config.json",

  "model": "lmstudio/prism-ml/bonsai-27b",

  "provider": {
    "lmstudio": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LM Studio",
      "options": {
        "baseURL": "http://127.0.0.1:1234/v1",
        "timeout": 600000
      },
      "models": {
        "liquid/lfm2-24b-a2b": {
          "name": "LFM2 24B A2B"
        },
        "prism-ml/bonsai-27b": {
          "name": "Bonsai 27B",
          "limit": {
            "context": 65536,
            "output": 8192
          }
        },
        "qwen/qwen3.5-9b": {
          "name": "Qwen3.5 9B",
          "limit": {
            "context": 16384,
            "output": 4096
          }
        }
      }
    }
  },

  "mcp": {
    "skyfire-rag": {
      "type": "local",
      "command": [
        "powershell.exe",
        "-NoProfile",
        "-NonInteractive",
        "-File",
        "tools/rag/start.ps1"
      ],
      "cwd": ".",
      "enabled": true,
      "timeout": 30000
    }
  },

  "skills": {
    "paths": [".agents/skills"]
  },

  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 16000
  },

  "watcher": {
    "ignore": [
      ".tmp/cache/**",
      ".git/**",
      "build/**",
      "node_modules/**"
    ]
  }
}
