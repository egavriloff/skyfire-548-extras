+void ObjectMgr::ApplyNpcTextLocale(uint32 entry, int32 localeIndex, GossipText& text) const
+{
+    if (localeIndex < 0 || localeIndex >= TOTAL_LOCALES)
+        return;
+    NpcTextLocale const* localized = GetNpcTextLocale(entry);
+    if (!localized)
+        return;
+    for (uint8 option = 0; option < MAX_GOSSIP_TEXT_OPTIONS; ++option)
+    {
+        GetLocaleString(localized->Text_0[option], localeIndex, text.Options[option].Text_0);
+        GetLocaleString(localized->Text_1[option], localeIndex, text.Options[option].Text_1);
+    }
+}
