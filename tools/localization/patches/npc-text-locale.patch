+// SQL locales_npc_text has twelve options, each with two text variants.
+constexpr uint8 NPC_TEXT_LOCALE_OPTIONS = 12;
+constexpr uint8 NPC_TEXT_LOCALE_VARIANTS = 2;
+constexpr uint32 NpcTextLocaleFieldIndex(uint8 locale, uint8 option, uint8 variant)
+{
+    return 1 + (locale - 1) * NPC_TEXT_LOCALE_OPTIONS * NPC_TEXT_LOCALE_VARIANTS
+        + option * NPC_TEXT_LOCALE_VARIANTS + variant;
